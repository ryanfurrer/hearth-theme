{
  "name": "hearth",
  "displayName": "Hearth",
  "description": "A warm color theme that keeps the interface calm and lights the code with a single ember.",
  "version": "0.3.0",
  "publisher": "ryanfurrer",
  "author": { "name": "Ryan Furrer", "url": "https://ryanfurrer.com" },
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Themes"],
  "keywords": ["theme", "color-theme", "warm", "duotone", "oklch", "orange", "ember", "hearth"],
  "homepage": "https://hearth.ryanfurrer.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanfurrer/hearth-theme.git"
  },
  "bugs": { "url": "https://github.com/ryanfurrer/hearth-theme/issues" },
  "galleryBanner": { "color": "#0a0a0b", "theme": "dark" },
  "scripts": {
    "build": "node build.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out hearth-latest.vsix"
  },
  "devDependencies": {
    "@iarna/toml": "2.2.5",
    "@vscode/vsce": "3.9.2",
    "ajv": "8.20.0",
    "ovsx": "1.1.1",
    "yaml": "2.9.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Hearth Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/hearth-dark.json"
      },
      {
        "label": "Hearth Dark Teal",
        "uiTheme": "vs-dark",
        "path": "./themes/hearth-dark-teal.json"
      },
      {
        "label": "Hearth Dark Azure",
        "uiTheme": "vs-dark",
        "path": "./themes/hearth-dark-azure.json"
      },
      {
        "label": "Hearth Light",
        "uiTheme": "vs",
        "path": "./themes/hearth-light.json"
      },
      {
        "label": "Hearth Light Teal",
        "uiTheme": "vs",
        "path": "./themes/hearth-light-teal.json"
      },
      {
        "label": "Hearth Light Azure",
        "uiTheme": "vs",
        "path": "./themes/hearth-light-azure.json"
      }
    ]
  }
}
