  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#626269",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "meta.attribute-selector string"
      ],
      "settings": {
        "foreground": "#dfbda0"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#f66335"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f66335"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#f87c49"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "keyword.other.self"
      ],
      "settings": {
        "foreground": "#f87c49",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace.round",
        "meta.brace.square",
        "punctuation.section",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#808085"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d7d7db"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c4c4c9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call",
        "entity.name.function.member",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4cd0b8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#8bddcb",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#f66335",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f87c49"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute.class",
        "meta.attribute.id"
      ],
      "settings": {
        "foreground": "#dfbda0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "meta.tag punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#808085"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#c4c4c9"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#dfbda0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#f87c49"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#f66335"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#f5f5f6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#fafafb",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#d7d7db",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#dfbda0"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#f05a29",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#a4a4a9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list punctuation.definition.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#f87c49"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#dfbda0"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#f87171",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
