  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#717178",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "meta.attribute-selector string"
      ],
      "settings": {
        "foreground": "#89552a"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#9f2e00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#9f2e00"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#b23c00"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "keyword.other.self"
      ],
      "settings": {
        "foreground": "#b23c00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace.round",
        "meta.brace.square",
        "punctuation.section",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5d5d63"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#2d2d33"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#48484e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call",
        "entity.name.function.member",
        "variable.function"
      ],
      "settings": {
        "foreground": "#008472"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#007161",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#9f2e00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#b23c00"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute.class",
        "meta.attribute.id"
      ],
      "settings": {
        "foreground": "#89552a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "meta.tag punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5d5d63"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#48484e"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#89552a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
